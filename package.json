{
  "name": "@zealakit/css-doctor-workspace",
  "version": "1.0.0",
  "description": "Smart CSS diagnostics, dead code elimination, and intelligent chunk splitting tool.",
  "author": "nqhed - Huy Edward Nguyen",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build --filter=\"./packages/**\"",
    "dev": "turbo dev",
    "test": "turbo run test --filter=\"./packages/**\"",
    "test:cargo": "cargo test --workspace",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "check": "turbo check",
    "clean": "turbo run clean && rm -rf node_modules",
    "monitor": "tsx monitor/server.ts",
    "typecheck": "turbo run typecheck --filter=\"./packages/**\"",
    "build:packages": "turbo run build --filter=\"./packages/**\"",
    "prepare:examples": "pnpm --filter \"./examples/*\" postinstall",
    "prepare": "pnpm build:packages && pnpm prepare:examples",
    "build:fast": "pnpm --filter=\"./packages/**\" --parallel run build",
    "build:examples": "turbo run build --filter=\"./examples/**\"",
    "build:all": "turbo run build",
    "publish:npm": "tsx scripts/publish-npm.ts --all",
    "publish:npm:binding": "tsx scripts/publish-npm.ts --binding",
    "publish:npm:adapters": "tsx scripts/publish-npm.ts --adapters",
    "publish:npm:dry": "tsx scripts/publish-npm.ts --all --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.20.5",
    "smol-toml": "^1.9.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealakit/css-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/zealakit/css-doctor/issues"
  },
  "homepage": "https://github.com/zealakit/css-doctor#readme"
}
