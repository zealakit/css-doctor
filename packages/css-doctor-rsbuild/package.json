{
  "name": "@zealakit/css-doctor-rsbuild",
  "version": "1.1.0",
  "description": "Rsbuild/Rspack integration for css-doctor page-coverage and size-budget CSS splitting",
  "keywords": [
    "css",
    "css-doctor",
    "rsbuild",
    "rspack",
    "rsbuild-plugin",
    "rspack-plugin",
    "webpack",
    "bundler",
    "css-analysis",
    "css-optimizer",
    "dead-code-elimination",
    "unused-css",
    "purgecss",
    "css-splitting",
    "page-coverage",
    "size-budget",
    "performance",
    "web-performance",
    "frontend",
    "build-tool"
  ],
  "author": "nqhed - Huy Edward Nguyen",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_VI.md",
    "README_CN.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && pnpm build && node --test test/**/*.test.mjs",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "check": "biome check src"
  },
  "dependencies": {
    "@zealakit/css-doctor-binding": "workspace:*",
    "@zealakit/css-doctor-shared": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=1.0.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.7.6",
    "@rspack/core": "^2.3.2",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealakit/css-doctor.git",
    "directory": "packages/css-doctor-rsbuild"
  },
  "bugs": {
    "url": "https://github.com/zealakit/css-doctor/issues"
  },
  "homepage": "https://github.com/zealakit/css-doctor#readme"
}
