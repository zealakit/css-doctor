{
  "name": "@zealakit/css-doctor-binding",
  "version": "1.0.0",
  "description": "Native Node.js bindings for the css-doctor CSS analysis engine",
  "keywords": [
    "css",
    "css-doctor",
    "css-analysis",
    "css-optimizer",
    "dead-code-elimination",
    "unused-css",
    "purgecss",
    "critical-css",
    "css-splitting",
    "page-coverage",
    "lightningcss",
    "native-addon",
    "napi",
    "napi-rs",
    "rust",
    "nodejs",
    "performance",
    "web-performance",
    "stylesheet",
    "frontend"
  ],
  "author": "nqhed - Huy Edward Nguyen",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealakit/css-doctor.git",
    "directory": "packages/binding"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.cts",
    "*.node",
    "README.md",
    "README_VI.md",
    "README_CN.md"
  ],
  "napi": {
    "name": "css-doctor-binding",
    "triples": {
      "defaults": true
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "pnpm build && pnpm typecheck && tsx test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint src test.ts",
    "format": "biome format --write src test.ts",
    "format:check": "biome format src test.ts",
    "check": "biome check src test.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@zealakit/css-doctor-binding-darwin-arm64": "workspace:*",
    "@zealakit/css-doctor-binding-darwin-x64": "workspace:*",
    "@zealakit/css-doctor-binding-linux-x64-gnu": "workspace:*",
    "@zealakit/css-doctor-binding-linux-x64-musl": "workspace:*",
    "@zealakit/css-doctor-binding-win32-x64-msvc": "workspace:*"
  },
  "bugs": {
    "url": "https://github.com/zealakit/css-doctor/issues"
  },
  "homepage": "https://github.com/zealakit/css-doctor#readme"
}
